# Copy to .env (cp .env.example .env). Placeholders only: never commit .env.

# Local-only master key for the gateway (Authorization: Bearer <key>).
# The placeholder works out of the box because the port is bound to 127.0.0.1 only.
# Replace it with your own value, and ALWAYS before exposing the port:
#   echo "LITELLM_MASTER_KEY=sk-local-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-local-change-me

# The `reasoning` alias endpoint (any OpenAI-compatible URL).
# Default: the local stand-in `tap` (forwards to the local 3B model), fully offline.
# Replace with your endpoint (e.g. a MeluXina or vLLM URL) and use docker-compose.remote.yml.
REASONING_API_BASE=http://tap:8080/v1
REASONING_API_KEY=not-needed-locally
# Name of the model on that endpoint. Default: the local 3B model.
REASONING_MODEL=granite4:3b
